# Database Configuration for GEMINI App
# Copy this to your main .env file or source it separately

# ============================================
# IMPORTANT: Your data files stay where they are!
# The database only stores metadata and file paths.
# Set DATA_ROOT_DIR to your existing data location.
# ============================================

# Your existing data directory (DO NOT MOVE FILES!)
# Inside container, this is mounted at /root/GEMINI-App-Data
DATA_ROOT_DIR=/root/GEMINI-App-Data
# Or use environment variable: ${REACT_APP_APP_DATA}

# ============================================
# PostgreSQL Configuration
# ============================================
POSTGRES_USER=gemini_user
POSTGRES_PASSWORD=gemini_password
POSTGRES_HOST=postgres  # Use 'postgres' when running in Docker, 'localhost' when running locally
POSTGRES_PORT=5432
POSTGRES_DB=gemini_db

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=redis  # Use 'redis' when running in Docker, 'localhost' when running locally
REDIS_PORT=6379

# ============================================
# Database Feature Flags
# ============================================
# Start with 'false', then switch to 'true' after migration
USE_DATABASE=true
ENABLE_CACHING=true  # Enable Redis caching

# SQLAlchemy settings
SQLALCHEMY_ECHO=false  # Set to 'true' for SQL query debugging
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_MAX_OVERFLOW=20

# ============================================
# Optional: Database Management Tools
# ============================================
# Uncomment to enable web UIs for database management

# pgAdmin (PostgreSQL web interface)
# PGADMIN_EMAIL=admin@example.com
# PGADMIN_PASSWORD=admin
# PGADMIN_PORT=5050

# Redis Commander (Redis web interface)
# REDIS_COMMANDER_PORT=8081

# ============================================
# Migration Settings
# ============================================
# Used by migration scripts
MIGRATION_BATCH_SIZE=1000
MIGRATION_VERBOSE=true
